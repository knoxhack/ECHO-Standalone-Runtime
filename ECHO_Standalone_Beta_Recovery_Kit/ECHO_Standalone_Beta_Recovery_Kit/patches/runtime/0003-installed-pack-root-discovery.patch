+package dev.echo.standalone.runtime.client;
+
+import java.nio.file.Path;
+
+record EchoClientLaunchOptions(Path packRoot, Path modulesRoot, boolean safeMode) {
+    private static final String PACK_ROOT_PROPERTY = "echo.pack.root";
+    private static final String MODULES_ROOT_PROPERTY = "echo.modules.root";
+
+    static EchoClientLaunchOptions parse(String[] args) {
+        Path packRoot = configuredPath(PACK_ROOT_PROPERTY, "ECHO_PACK_ROOT");
+        Path modulesRoot = configuredPath(MODULES_ROOT_PROPERTY, "ECHO_MODULES_ROOT");
+        boolean safeMode = false;
+        String[] safeArgs = args == null ? new String[0] : args;
+        for (int i = 0; i < safeArgs.length; i++) {
+            String argument = safeArgs[i] == null ? "" : safeArgs[i].trim();
+            switch (argument) {
+                case "--pack-root" -> packRoot = requiredPath(safeArgs, ++i, argument);
+                case "--modules-root" -> modulesRoot = requiredPath(safeArgs, ++i, argument);
+                case "--safe-mode" -> safeMode = true;
+                case "" -> { }
+                default -> throw new IllegalArgumentException("Unknown ECHO Standalone argument: " + argument);
+            }
+        }
+        Path normalizedPackRoot = normalize(packRoot == null ? Path.of(".") : packRoot);
+        Path normalizedModulesRoot = normalize(
+                modulesRoot == null ? normalizedPackRoot.resolve("mods") : modulesRoot
+        );
+        return new EchoClientLaunchOptions(normalizedPackRoot, normalizedModulesRoot, safeMode);
+    }
+
+    void applySystemProperties() {
+        System.setProperty(PACK_ROOT_PROPERTY, packRoot.toString());
+        System.setProperty(MODULES_ROOT_PROPERTY, modulesRoot.toString());
+        System.setProperty("echo.safe.mode", Boolean.toString(safeMode));
+    }
+
+    private static Path requiredPath(String[] args, int index, String option) {
+        if (index >= args.length || args[index] == null || args[index].isBlank()) {
+            throw new IllegalArgumentException("Missing path after " + option);
+        }
+        return Path.of(args[index]);
+    }
+
+    private static Path configuredPath(String property, String environment) {
+        String value = System.getProperty(property, "").trim();
+        if (value.isBlank()) {
+            value = System.getenv(environment);
+        }
+        return value == null || value.isBlank() ? null : Path.of(value);
+    }
+
+    private static Path normalize(Path path) {
+        return path.toAbsolutePath().normalize();
+    }
+}
