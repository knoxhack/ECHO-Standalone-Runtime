  "interactionCatalog": {
    "rules": [
      {
        "matchTokens": ["cache", "crate", "chest", "container"],
        "command": "OPEN_CONTAINER"
      },
      {
        "matchTokens": [
          "workbench",
          "crafting_table",
          "crafting table",
          "bench",
          "runtime_marker"
        ],
        "command": "OPEN_WORKBENCH"
      },
      {
        "matchTokens": [
          "scrap_press",
          "factory_controller",
          "research_lab",
          "filter_workbench",
          "power_node"
        ],
        "command": "OPEN_MACHINE"
      },
      {
        "matchTokens": ["terminal"],
        "command": "OPEN_REGISTERED_SCREEN",
        "targetId": "echoterminal:ui/field_terminal"
      },
      {
        "matchTokens": ["scanner", "diagnostic"],
        "command": "OPEN_DIAGNOSTICS"
      }
